# Use mock for local development. Set openai or gemini to enable a provider.
AI_PROVIDER=mock

# Configure only the key for the selected provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Must match API's AI_SERVICE_API_KEY when provided.
AI_SERVICE_API_KEY=local-dev-change-this-key
MAX_RESUME_SIZE_MB=5
