# PostgreSQL connection string. Create a local database named careerpilot first.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/careerpilot

# Generate a random value with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=1h

# The API accepts browser requests only from these comma-separated origins.
CORS_ORIGINS=http://localhost:5173
PORT=4000

# Where uploaded resumes are stored on this computer.
RESUME_STORAGE_PATH=./uploads/resumes
MAX_RESUME_SIZE_MB=5

# Python FastAPI service. Keep it bound to localhost during development.
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_API_KEY=local-dev-change-this-key
